<Window x:Class="RemoteLink.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteLink Host" Height="520" Width="760"
        MinHeight="460" MinWidth="680" Background="#101827"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="RemoteLink" Foreground="White" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Windows host · Windows 11" Foreground="#9CAEC4" FontSize="14" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#1D2A3D" CornerRadius="10" Padding="16" Margin="0,24,0,18">
            <StackPanel>
                <TextBlock Text="主機狀態" Foreground="#AFC1D8" FontSize="13"/>
                <TextBlock x:Name="StatusText" Text="尚未連線" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="配對碼" Foreground="#AFC1D8" FontSize="13"/>
            <TextBlock x:Name="PairCodeText" Grid.Row="1" Text="------" Foreground="#71D5B3" FontSize="38" FontWeight="Bold" Margin="0,5,0,16"/>
            <TextBlock Grid.Row="2" TextWrapping="Wrap" Foreground="#C5D1DF" FontSize="14" LineHeight="23"
                       Text="目前為 Windows Host 初始介面。此版本尚未啟動桌面擷取、WebRTC 串流或遠端輸入。請勿將此版本視為可遠端控制的正式產品。首次配對與每次遠端工作階段都應由使用者明確授權，並提供可見的停止控制。"/>
        </Grid>
        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button x:Name="StartButton" Content="啟動主機" Width="130" Height="40" Click="StartButton_Click"
                    Background="#267A68" Foreground="White" BorderThickness="0" FontSize="14"/>
            <Button x:Name="StopButton" Content="停止主機" Width="130" Height="40" Margin="12,0,0,0"
                    Click="StopButton_Click" Background="#873E4A" Foreground="White" BorderThickness="0" FontSize="14" IsEnabled="False"/>
        </DockPanel>
    </Grid>
</Window>
